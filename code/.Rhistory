smoothed.scaled.hist = function(dat.ls, bin_width, scale.factors, cols=NULL, ...) {
bin_width <- 100
min_break <- floor(min(unlist(dat.ls)) / bin_width) * bin_width
max_break <- ceiling(max(unlist(dat.ls)) / bin_width) * bin_width
breaks <- seq(min_break, max_break, by = bin_width)
labels=names(dat.ls)
names(labels)=labels
if (is.null(col)) cols=1:length(dat.ls)
# get histogram info without plotting
hist_info <- lapply(labels, function (a) hist(dat.ls[[a]], breaks = breaks, plot = FALSE) )
for (a in labels) {
# normalize the histogram counts to 100 um width
hist_info[[a]]$counts <- hist_info[[a]]$counts * scale.factors[a]
}
# estimate density curve
densities <- lapply(labels, function (a) density(dat.ls[[a]]) )
for (a in labels) {
# Scale the height of the density curve to match the histogram's frequency
densities[[a]]$y <- densities[[a]]$y * diff(hist_info[[a]]$mids[1:2]) * length(dat.ls[[a]])
# normalize the density curve height to 100 um width
densities[[a]]$y <- densities[[a]]$y * scale.factors[a]
}
plot(hist_info[[1]], freq = TRUE, border="white",  col="gray", ...)
for (i in 1:length(labels)) lines(densities[[i]], col = cols[i])
# to divide between epi and dermis
# if (dist == "dist2DEJ") abline(v=0, lty=2)
mylegend(x=3, legend=labels, lty=1, col=1:length(labels), y.intersp=1, text.width=700)
}
for (s in sample.labels) {
for (a in markers) {
# dist="dist2skin"; a="CD3"; s="DD"
dat.ls = alldat[[s]][[dist]][[a]]
dat.ls = lapply(tissue.types, function (t) dat.ls[dat.ls[[t]],"dist"])
scale.factors=sapply(tissue.types, function(tissue.type) unname(100/tissue.widths[[tissue.type]][s]))
smoothed.scaled.hist(dat.ls, bin_width=100, scale.factors=scale.factors,
xlim=xlim.ls[[dist]], ylim=c(0,150),
xlab=dist %.% " (um)", ylab="Number of cells/100x100 um2",
main=ifelse(s=="DD",a,""),
col=c("red","blue")
)
}
}
smoothed.scaled.hist = function(dat.ls, bin_width, scale.factors, cols=NULL, ...) {
bin_width <- 100
min_break <- floor(min(unlist(dat.ls)) / bin_width) * bin_width
max_break <- ceiling(max(unlist(dat.ls)) / bin_width) * bin_width
breaks <- seq(min_break, max_break, by = bin_width)
labels=names(dat.ls)
names(labels)=labels
if (is.null(col)) cols=1:length(dat.ls)
# get histogram info without plotting
hist_info <- lapply(labels, function (a) hist(dat.ls[[a]], breaks = breaks, plot = FALSE) )
for (a in labels) {
# normalize the histogram counts to 100 um width
hist_info[[a]]$counts <- hist_info[[a]]$counts * scale.factors[a]
}
# estimate density curve
densities <- lapply(labels, function (a) density(dat.ls[[a]]) )
for (a in labels) {
# Scale the height of the density curve to match the histogram's frequency
densities[[a]]$y <- densities[[a]]$y * diff(hist_info[[a]]$mids[1:2]) * length(dat.ls[[a]])
# normalize the density curve height to 100 um width
densities[[a]]$y <- densities[[a]]$y * scale.factors[a]
}
plot(hist_info[[1]], freq = TRUE, border="white",  col="gray", ...)
for (i in 1:length(labels)) lines(densities[[i]], col = cols[i])
# to divide between epi and dermis
# if (dist == "dist2DEJ") abline(v=0, lty=2)
mylegend(x=3, legend=labels, lty=1, col=cols, y.intersp=1, text.width=700)
}
for (s in sample.labels) {
for (a in markers) {
# dist="dist2skin"; a="CD3"; s="DD"
dat.ls = alldat[[s]][[dist]][[a]]
dat.ls = lapply(tissue.types, function (t) dat.ls[dat.ls[[t]],"dist"])
scale.factors=sapply(tissue.types, function(tissue.type) unname(100/tissue.widths[[tissue.type]][s]))
smoothed.scaled.hist(dat.ls, bin_width=100, scale.factors=scale.factors,
xlim=xlim.ls[[dist]], ylim=c(0,150),
xlab=dist %.% " (um)", ylab="Number of cells/100x100 um2",
main=ifelse(s=="DD",a,""),
col=c("red","blue")
)
}
}
################################################################################
# compare DD and CF in one plot
# 8 plots for each of dist2skin and dist2DEJ:
# 4 markers in lesion
# 4 markers in intact
for (dist in dist.labels) {
mypng(mfrow=c(2,4), width=10, height=5, mar=c(4,4,2,1), oma=c(1,3,0,0),
file=paste0("figures/compare_normal_lesion_"%.%dist))
for (s in sample.labels) {
for (a in markers) {
# dist="dist2skin"; a="CD3"; s="DD"
dat.ls = alldat[[s]][[dist]][[a]]
dat.ls = lapply(tissue.types, function (t) dat.ls[dat.ls[[t]],"dist"])
scale.factors=sapply(tissue.types, function(tissue.type) unname(100/tissue.widths[[tissue.type]][s]))
smoothed.scaled.hist(dat.ls, bin_width=100, scale.factors=scale.factors,
xlim=xlim.ls[[dist]], ylim=c(0,150),
xlab=dist %.% " (um)", ylab="Number of cells/100x100 um2",
main=ifelse(s=="DD",a,""),
col=c("red","blue")
)
}
}
mtext(sample.labels[1], side = 2, line = 1.5, outer = T, at = .75, adj = NA, padj = NA, cex = NA, col = NA, font = NA)
mtext(sample.labels[2], side = 2, line = 1.5, outer = T, at = .25, adj = NA, padj = NA, cex = NA, col = NA, font = NA)
dev.off()
}
smoothed.scaled.hist = function(dat.ls, bin_width, scale.factors, cols=NULL, ...) {
bin_width <- 100
min_break <- floor(min(unlist(dat.ls)) / bin_width) * bin_width
max_break <- ceiling(max(unlist(dat.ls)) / bin_width) * bin_width
breaks <- seq(min_break, max_break, by = bin_width)
labels=names(dat.ls)
names(labels)=labels
if (is.null(col)) cols=1:length(dat.ls)
# get histogram info without plotting
hist_info <- lapply(labels, function (a) hist(dat.ls[[a]], breaks = breaks, plot = FALSE) )
for (a in labels) {
# normalize the histogram counts to 100 um width
hist_info[[a]]$counts <- hist_info[[a]]$counts * scale.factors[a]
}
# estimate density curve
densities <- lapply(labels, function (a) density(dat.ls[[a]]) )
for (a in labels) {
# Scale the height of the density curve to match the histogram's frequency
densities[[a]]$y <- densities[[a]]$y * diff(hist_info[[a]]$mids[1:2]) * length(dat.ls[[a]])
# normalize the density curve height to 100 um width
densities[[a]]$y <- densities[[a]]$y * scale.factors[a]
}
hist.col = col2rgb(cols[1])
hist.col = rgb(hist.col[1], hist.col[2], hist.col[3], alpha=255*.5, maxColorValue=255)
plot(hist_info[[1]], freq = TRUE, border="white",  col=hist.col, ...)
for (i in 1:length(labels)) lines(densities[[i]], col = cols[i])
# to divide between epi and dermis
# if (dist == "dist2DEJ") abline(v=0, lty=2)
mylegend(x=3, legend=labels, lty=1, col=cols, y.intersp=1, text.width=700)
}
################################################################################
# compare DD and CF in one plot
# 8 plots for each of dist2skin and dist2DEJ:
# 4 markers in lesion
# 4 markers in intact
for (dist in dist.labels) {
mypng(mfrow=c(2,4), width=10, height=5, mar=c(4,4,2,1), oma=c(1,3,0,0),
file=paste0("figures/compare_normal_lesion_"%.%dist))
